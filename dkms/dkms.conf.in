PACKAGE_NAME="bcachefs"
PACKAGE_VERSION="@PACKAGE_VERSION@"
AUTOINSTALL=yes

BUILT_MODULE_NAME[0]="bcachefs"
BUILT_MODULE_LOCATION[0]="src/fs/bcachefs"
DEST_MODULE_LOCATION[0]="/kernel/fs/bcachefs"
STRIP[0]="no"
# fs/util/compat.h supplies the post-6.12 APIs; older kernels are not supported
BUILD_EXCLUSIVE_KERNEL_MIN="6.12"
