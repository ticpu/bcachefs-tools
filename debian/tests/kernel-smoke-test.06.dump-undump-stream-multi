#!/bin/sh

set +e
set -x

echo "kernel smoke test, multi-device dump/undump streaming round-trip with --device selector"

# Two-device fs: stream each device to its own restored image with --device N
SRC0="$TMPDIR/src0.img"
SRC1="$TMPDIR/src1.img"
R0="$TMPDIR/r0.img"
R1="$TMPDIR/r1.img"
SRC_MNT="$TMPDIR/src.mnt"
DST_MNT="$TMPDIR/dst.mnt"
LO0="" ; LO1="" ; LOr0="" ; LOr1=""

cleanup() {
	umount "$SRC_MNT" 2>/dev/null
	umount "$DST_MNT" 2>/dev/null
	for lo in "$LO0" "$LO1" "$LOr0" "$LOr1"; do
		[ -n "$lo" ] && losetup -d "$lo" 2>/dev/null
	done
}
trap cleanup EXIT

mkdir -p "$SRC_MNT" "$DST_MNT"
truncate -s 512M "$SRC0"
truncate -s 512M "$SRC1"
if [ $? -ne 0 ]; then echo "FAILED: truncate images"; exit 1; fi

LO0="$(losetup --find --show "$SRC0")"
LO1="$(losetup --find --show "$SRC1")"
if [ -z "$LO0" ] || [ -z "$LO1" ]; then echo "FAILED: losetup source"; exit 1; fi

bcachefs format --compression=lz4 "$LO0" "$LO1"
if [ $? -ne 0 ]; then echo "FAILED: format"; exit 1; fi

mount -t bcachefs "$LO0:$LO1" "$SRC_MNT"
if [ $? -ne 0 ]; then echo "FAILED: mount source"; exit 1; fi

# Populate: >256KiB random file, second file, xattr, reflink, snapshot subvolume
head -c 300000 /dev/urandom > "$SRC_MNT/rand.bin"
head -c 100000 /dev/urandom > "$SRC_MNT/second.bin"
setfattr -n user.testattr -v "multi-stream" "$SRC_MNT/rand.bin"
cp --reflink=always "$SRC_MNT/rand.bin" "$SRC_MNT/rand.reflink"
bcachefs subvolume create "$SRC_MNT/snap"
echo "snapshot content" > "$SRC_MNT/snap/file.txt"
bcachefs subvolume snapshot "$SRC_MNT/snap" "$SRC_MNT/snap_ro"
if [ $? -ne 0 ]; then echo "FAILED: populate (xattr/reflink/snapshot)"; exit 1; fi

sync
( cd "$SRC_MNT" && find . -type f | sort | while read -r f; do
	printf '%s  %s\n' "$f" "$(sha256sum "$f" | awk '{print $1}')"
done ) > "$TMPDIR/src.sha"
( cd "$SRC_MNT" && getfattr -R -h -m '^user\.' -d . 2>/dev/null | sort ) > "$TMPDIR/src.xattr"

umount "$SRC_MNT"
if [ $? -ne 0 ]; then echo "FAILED: umount source"; exit 1; fi

# Stream each device to its own restored image
bcachefs dump -o - --device 0 "$LO0" "$LO1" > "$TMPDIR/s0.qcow2"
[ $? -eq 0 ] || { echo "FAILED: dump dev0"; exit 1; }
bcachefs undump -f - "$R0" < "$TMPDIR/s0.qcow2"
[ $? -eq 0 ] || { echo "FAILED: undump dev0"; exit 1; }
if [ ! -f "$R0" ]; then echo "FAILED: r0.img not created"; exit 1; fi

bcachefs dump -o - --device 1 "$LO0" "$LO1" > "$TMPDIR/s1.qcow2"
[ $? -eq 0 ] || { echo "FAILED: dump dev1"; exit 1; }
bcachefs undump -f - "$R1" < "$TMPDIR/s1.qcow2"
[ $? -eq 0 ] || { echo "FAILED: undump dev1"; exit 1; }
if [ ! -f "$R1" ]; then echo "FAILED: r1.img not created"; exit 1; fi

# Detach source loops: restored images share the source UUID
losetup -d "$LO0"
losetup -d "$LO1"
LO0="" ; LO1=""

# Device-level fidelity on pristine restored images
bad0=$(cmp -l "$SRC0" "$R0" | awk '$3 != "0" { n++ } END { print n+0 }')
total0=$(cmp -l "$SRC0" "$R0" | wc -l)
echo "device compare $SRC0 vs $R0: $total0 differing bytes, $bad0 non-zero-in-restored"
if [ "$bad0" -ne 0 ]; then echo "FAILED: restored device 0 diverges from source"; exit 1; fi

bad1=$(cmp -l "$SRC1" "$R1" | awk '$3 != "0" { n++ } END { print n+0 }')
total1=$(cmp -l "$SRC1" "$R1" | wc -l)
echo "device compare $SRC1 vs $R1: $total1 differing bytes, $bad1 non-zero-in-restored"
if [ "$bad1" -ne 0 ]; then echo "FAILED: restored device 1 diverges from source"; exit 1; fi

LOr0="$(losetup --find --show "$R0")"
LOr1="$(losetup --find --show "$R1")"
if [ -z "$LOr0" ] || [ -z "$LOr1" ]; then echo "FAILED: losetup restored"; exit 1; fi

mount -t bcachefs "$LOr0:$LOr1" "$DST_MNT"
if [ $? -ne 0 ]; then echo "FAILED: mount restored"; exit 1; fi

sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null

( cd "$DST_MNT" && find . -type f | sort | while read -r f; do
	printf '%s  %s\n' "$f" "$(sha256sum "$f" | awk '{print $1}')"
done ) > "$TMPDIR/dst.sha"
( cd "$DST_MNT" && getfattr -R -h -m '^user\.' -d . 2>/dev/null | sort ) > "$TMPDIR/dst.xattr"

umount "$DST_MNT"

diff -u "$TMPDIR/src.sha" "$TMPDIR/dst.sha"
if [ $? -ne 0 ]; then echo "FAILED: file content differs after round-trip"; exit 1; fi
diff -u "$TMPDIR/src.xattr" "$TMPDIR/dst.xattr"
if [ $? -ne 0 ]; then echo "FAILED: xattrs differ after round-trip"; exit 1; fi

grep -q '^\./snap/' "$TMPDIR/dst.sha"
if [ $? -ne 0 ]; then echo "FAILED: snapshot not found"; exit 1; fi

echo "PASSED"
exit 0
